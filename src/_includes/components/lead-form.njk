<div class="lead-form-card">
                    <form
                        id="lead-form"
                        action="{{ site.integrations.formAction }}"
                        method="post"
                    >
                        <div class="form-field">
                            <label for="nome">Qual o seu nome?</label>
                            <input id="nome" name="nome" type="text" autocomplete="name" maxlength="100" required>
                        </div>

                        <div class="form-field">
                            <label for="whatsapp">Qual seu WhatsApp com DDD para entrarmos em contato?</label>
                            <input
                                id="whatsapp"
                                name="whatsapp"
                                type="tel"
                                inputmode="tel"
                                autocomplete="tel"
                                maxlength="20"
                                placeholder="(11) 99999-9999"
                                required
                            >
                        </div>

                        <div class="form-field">
                            <label for="perfil-google">Qual o nome do Perfil da sua Empresa no Google?</label>
                            <input id="perfil-google" name="perfil_google" type="text" maxlength="200" required>
                        </div>

                        <div class="form-field">
                            <label for="motivo">O que te fez procurar uma agência de marketing?</label>
                            <textarea id="motivo" name="motivo" rows="5" maxlength="1500" required></textarea>
                        </div>

                        <div class="honeypot" aria-hidden="true">
                            <label for="website">Não preencha este campo</label>
                            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off">
                        </div>

                        <input type="hidden" name="utm_source">
                        <input type="hidden" name="utm_medium">
                        <input type="hidden" name="utm_campaign">
                        <input type="hidden" name="utm_content">
                        <input type="hidden" name="utm_term">
                        <input type="hidden" name="pagina">

                        <label class="consent-field">
                            <input name="consentimento" type="checkbox" value="sim" required>
                            <span>Autorizo o uso destes dados para receber contato sobre minha análise pelo WhatsApp.</span>
                        </label>

                        <button class="button button-primary button-large form-submit" type="submit">
                            <span>Solicitar Análise</span>
                        </button>
                        <p class="form-note">Seus dados não serão publicados nem enviados ao Meta.</p>
                        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
                    </form>
                </div>
