{% if isLegal %}    <header class="site-header">
        <div class="container legal-header-inner">
            <a class="brand" href="/" aria-label="{{ site.name }} — página inicial">
                <img class="brand-logo" src="/{{ site.brand.logo }}" alt="{{ site.name }}" width="{{ site.brand.logoWidth }}" height="{{ site.brand.logoHeight }}">
            </a>
            <a class="button legal-back" href="/">Voltar ao site</a>
        </div>
    </header>
{% else %}    <header class="site-header" id="topo">
        <div class="container header-inner">
            <a class="brand" href="{% if isHome %}#inicio{% else %}/{% endif %}" aria-label="{{ site.name }} — página inicial">
                <img class="brand-logo" src="/{{ site.brand.logo }}" alt="{{ site.name }}" width="{{ site.brand.logoWidth }}" height="{{ site.brand.logoHeight }}">
            </a>
            <nav class="desktop-nav" aria-label="Navegação principal">
{% for item in navigation.primary %}                <a href="{{ item.url }}"{% if navKey == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a>
{% endfor %}            </nav>
            <details class="mobile-menu">
                <summary>Menu</summary>
                <nav aria-label="Navegação móvel">
{% for item in navigation.primary %}                    <a href="{{ item.url }}"{% if navKey == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a>
{% endfor %}                </nav>
            </details>
            <a
                class="button button-whatsapp button-small"
                href="{{ site.links.whatsapp }}"
                target="_blank"
                rel="noopener noreferrer"
                data-track="whatsapp_click"
                data-location="header"
            >Falar no WhatsApp</a>
        </div>
    </header>
{% endif %}
