{% set service = services.items[serviceKey] %}
        <section class="page-hero service-page-hero">
            <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
            <div class="container">
                {% include "partials/breadcrumbs.njk" %}
                <div class="page-hero-grid">
                    <div>
                        <p class="eyebrow">{{ service.eyebrow }}</p>
                        <h1>{{ pages.entries[pageKey].h1 }}</h1>
                        <p class="page-hero-lead">{{ service.lead }}</p>
                        <div class="hero-actions">
                            <a class="button button-primary button-large" href="/contato/" data-track="contact_click" data-location="service_hero">Conversar sobre este serviço</a>
{% if serviceKey == "profile" %}                            <a class="button button-secondary" href="/diagnostico-google-meu-negocio/" data-track="diagnostic_click" data-location="service_hero">Começar pelo diagnóstico</a>
{% endif %}                        </div>
                    </div>
                    <div class="page-summary service-summary">
                        <span>Serviço {{ service.number }}</span>
                        <p>{{ service.shortName }}</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="section definition-section">
            <div class="container content-split">
                <div>
                    <p class="eyebrow eyebrow-dark">O que é</p>
                    <h2>{{ service.name }}</h2>
                    <p class="lead-paragraph">{{ service.definition }}</p>
                </div>
                <div class="audience-panel">
                    <h2>Para quem faz sentido</h2>
                    <ul class="check-list">
{% for item in service.audience %}                        <li>{{ item }}</li>
{% endfor %}                    </ul>
                </div>
            </div>
        </section>

        <section class="section problem-section service-problems">
            <div class="container section-heading">
                <p class="eyebrow eyebrow-dark">Problemas que o trabalho ajuda a enfrentar</p>
                <h2>O ponto de partida precisa ser visível e específico.</h2>
            </div>
            <div class="container pain-grid">
{% for problem in service.problems %}                <article class="pain-card">
                    <span>0{{ loop.index }}</span>
                    <h3>{{ problem.title }}</h3>
                    <p>{{ problem.text }}</p>
                </article>
{% endfor %}            </div>
        </section>

        <section class="section scope-section">
            <div class="container section-heading-row">
                <div><p class="eyebrow eyebrow-dark">Escopo</p><h2>O que pode ser trabalhado.</h2></div>
                <p>O conjunto final depende da situação atual, das informações confirmadas e do escopo acordado.</p>
            </div>
            <div class="container feature-grid">
{% for item in service.scope %}                <article><span>{{ loop.index }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p></article>
{% endfor %}            </div>
        </section>

        <section class="section process-section">
            <div class="container section-heading centered-heading">
                <p class="eyebrow">Como funciona</p>
                <h2>Um processo com contexto, execução e acompanhamento.</h2>
            </div>
            <ol class="container editorial-steps">
{% for step in service.process %}                <li><span>0{{ loop.index }}</span><div><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div></li>
{% endfor %}            </ol>
        </section>

        <section class="section faq-section">
            <div class="container narrow-container">
                <p class="eyebrow eyebrow-dark">Perguntas frequentes</p>
                <h2>Antes de decidir</h2>
                <div class="faq-list">
{% for item in service.faq %}                    <details>
                        <summary>{{ item.question }}</summary>
                        <p>{{ item.answer }}</p>
                    </details>
{% endfor %}                </div>
            </div>
        </section>

        <section class="section related-section">
            <div class="container section-heading"><p class="eyebrow eyebrow-dark">Próximos caminhos</p><h2>Serviços e ações relacionados.</h2></div>
            <div class="container related-grid">
{% for item in service.related %}                <a href="{{ item.url }}"><strong>{{ item.label }}</strong><span>{{ item.text }}</span><em aria-hidden="true">→</em></a>
{% endfor %}                <a href="/contato/"><strong>Fale com Caroline</strong><span>Explique o cenário e descubra qual frente merece prioridade.</span><em aria-hidden="true">→</em></a>
            </div>
        </section>

        <section class="final-cta institutional-final-cta">
            <div class="container final-cta-inner">
                <div><p class="eyebrow">Conversa sem promessa pronta</p><h2>Entenda se este serviço corresponde ao momento do seu negócio.</h2><p>O primeiro passo é contextualizar a necessidade, a estrutura disponível e o objetivo comercial.</p></div>
                <a class="button button-whatsapp button-large" href="{{ site.links.whatsapp }}" target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-location="service_final">Falar no WhatsApp</a>
            </div>
        </section>
